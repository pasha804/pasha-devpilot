# ==============================================================================
# PASHA DEVPILOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security & Sessions
SECRET_KEY=your_secret_key_here_min_32_chars_change_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in prod, SQLite async for local dev fallback)
DATABASE_URL=sqlite+aiosqlite:///./pasha_devpilot.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pasha_devpilot

# Redis / Task Queue (Optional in dev, falls back to in-memory async task runner)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback
GITHUB_APP_NAME=PashaDevPilot

# IBM Bob Provider (primary — IBM Bob Hackathon)
BOB_API_KEY=your_ibm_bob_api_key_here
BOB_BASE_URL=https://api.bob.ibm.com/v1
BOB_MODEL=bob-code-plus

# AI Provider Configuration: "bob" | "deepseek" | "groq" | "cleanapis" | "openai" | "anthropic" | "gemini" | "mock"
AI_PROVIDER=deepseek
AI_BASE_URL=https://cleanapis.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=deepseek-v4-flash-0731

# Development Mode (DeepSeek V4 Flash — fallback when BOB_API_KEY not set)
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-v4-flash-0731
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://cleanapis.com/v1

# Verification Mode (High-Quality Groq Engine)
AI_VERIFICATION_PROVIDER=groq
AI_VERIFICATION_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Other Optional Provider Keys
CLEANAPIS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution & Sandbox Mode: "sandbox" | "local_safe" | "mock"
EXECUTION_MODE=local_safe
SANDBOX_TIMEOUT_SECONDS=60
MAX_SELF_HEALING_ATTEMPTS=3

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
